{
    "nodes": [
        {
            "node": "Authors",
            "example": [
                "Avi Ma'ayan",
                "Daniel J B Clarke"
            ],
            "display": [
                {
                    "label": "label",
                    "text": "${label}",
                    "type": "text"
                },
                {
                    "label": "Affiliation",
                    "text": "${affiliation}",
                    "type": "text"
                }
            ],
            "relation": [
		"Publications",
		"MeSH Term"
			],
            "search": [
                "label"
            ],
	    "color": "#80D8FF"
        },
        {
            "node": "Publication",
            "example": [
				"3D virtual reality vs. 2D desktop regist..."
            ],
            "display": [
                {
                    "label": "label",
                    "text": "${label}",
                    "type": "text"
                },
                {
                    "label": "URL",
                    "text": "${PMID}",
                    "href": "${url}",
                    "type": "link"
                },
                {
                    "label": "Title",
                    "text": "${Title}",
                    "type": "text"
                },
                {
                    "label": "Journal",
                    "text": "${Journal}",
                    "type": "text"
                },
                {
                    "label": "Volume",
                    "text": "${Volume}",
                    "type": "text"
                },
                {
                    "label": "Issue",
                    "text": "${Issue}",
                    "type": "text"
                },
                {
                    "label": "Pages",
                    "text": "${Pages}",
                    "type": "text"
                },
                {
                    "label": "Year",
                    "text": "${Year}",
                    "type": "text"
                }
            ],
            "relation": [
		"Publications",
		"MeSH Term"	
	    ],
            "search": [
		"label",
                "Title"
            ],
	    "color": "#97BDB8"
        },
        {
            "node": "MeSH",
            "example": [
                "Acetates",
                "Data Mining"
            ],
            "display": [
                {
                    "label": "label",
                    "text": "${label}",
                    "type": "text"
                }
            ],
            "relation": [
				"MeSH Term"
			],
            "search": [
                "label"
            ],
			"color": "#b1f774"
        }
    ],
    "edges": [
        {
            "match": [
                "Publications"
            ],
            "selected": true,
            "display": [
                {
                    "label": "source label",
                    "text": "${source_label}",
                    "type": "text"
                },
                {
                    "label": "relation",
                    "text": "${relation}",
                    "type": "text"
                },
                {
                    "label": "target label",
                    "text": "${target_label}",
                    "type": "text"
                }
            ]
        },
        {
            "match": [
                "MeSH Term"
            ],
            "selected": true,
            "display": [
                {
                    "label": "source label",
                    "text": "${source_label}",
                    "type": "text"
                },
                {
                    "label": "relation",
                    "text": "${relation}",
                    "type": "text"
                },
                {
                    "label": "target label",
                    "text": "${target_label}",
                    "type": "text"
                }
            ]
        }
    ],
    "header": {
        "header": "CFDE Co-authorship Network",
        "title": "CFDE Co-authorship Network",
        "background": {
            "backgroundColor": "#000",
            "contrastText": "#FFF"
        },
        "icon": {
            "src": "https://s3.amazonaws.com/maayan-kg/cfde-kg/assets/CFDE.png",
            "favicon": "https://s3.amazonaws.com/maayan-kg/cfde-kg/assets/favicon.png",
            "faviconTitle": "CFDE Co-author Network",
            "alt": "CFDE logo",
            "key": "CFDE_logo",
            "width": 100,
            "height": 100
        },
        "tabs": [
            {
                "endpoint": "/",
                "label": "Co-authorship KG Explorer",
                "type": "page",
                "component": "KnowledgeGraph",
                "props": {
					"description": "Explore the connections between the authors their publications and related MeSH terms.",
                    "init_function": "initialize_kg",
                    "initial_query": {
                        "start": "Authors",
                        "start_term": "Avi Ma'ayan",
						"relation": [
							{
								"name":"Publications",
								"limit": 10
							},
							{
								"name":"MeSH Term",
								"limit": 5	
							}
						]
                    },
                    "subheader": {
                        "url_field": "filter",
                        "query_field": "relation"
                    }
                }
            },
			{
				"endpoint": "/Coauthor",
				"label": "Co-authorship Minimum Connections Search",
				"type": "page",
				"component": "UseCase",
				"props": {
					"init_function": "initialize_kg",
					"title": "Co-author Search",
					"description": "Find related co-authors to the author in question. The slider controls the minimum number of shared publications for the co-authors to appear in the Knowledge Graph",
					"endpoint": "/api/coauthor",
					"type": "Authors",
					"options_endpoint": "/api/knowledge_graph/node_search",
					"default_term": "Avi Ma'ayan",
					"fields": [
						"label"
					]
				}
			}
        ]
    },
    "footer": {
        "style": {
            "background": "#336699",
            "color": "#FFF"
        },
		"layout": [
            [
                {
                    "component": "logo",
                    "props": {
            			"src": "https://raw.githubusercontent.com/MaayanLab/CFDECoauthorNetwork/refs/heads/next14/public/img/CFDE_Circle.png",
                        "title": "CFDE Co-authorship Network",
                        "color": "#FFF",
                        "size": "small"
                    }
                },
                {
                    "component": "github",
                    "props": {
                        "code": "https://github.com/MaayanLab/CFDECoauthorNetwork",
                        "issues": "https://github.com/MaayanLab/CFDECoauthorNetwork/issues/new"
                    }
                }
            ],
            [
				{
					"component": "text",
                    "props": {
                        "text": "Consortium"
					}
				},
				{
					"component": "link",
                    "props": {
                        "text": "Information Portal",
                        "href": "https://info.cfde.cloud/"
					}
				},
				{
					"component": "link",
                    "props": {
                        "text": "Data Portal",
                        "href": "https://data.cfde.cloud/"
					}
				}
            ],
            [
                {
                    "component": "icon",
                    "props": {
                        "type": "icon",
                        "key": "lab_icon",
                        "src": "https://minio.dev.maayanlab.cloud/enrichr-kg/maayanlab.png",
                        "alt": "MaayanLab",
                        "href": "https://labs.icahn.mssm.edu/maayanlab/",
                        "height": 60,
                        "width": 150
                    }
                }
            ],
            [
                {
                    "component": "icon",
                    "props": {
                        "type": "icon",
                        "key": "center_icon",
                        "src": "https://minio.dev.maayanlab.cloud/enrichr-kg/bioinformatics.png",
                        "alt": "COB",
                        "href": "https://icahn.mssm.edu/research/bioinformatics",
                        "height": 60,
                        "width": 150
                    }
                }
            ]
        ]
    },
    "ui_theme": "cfde_theme"
}
