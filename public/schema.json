{
    "nodes": [
        {
            "node": "Authors",
            "example": [
                "Avi Ma'ayan",
                "Daniel J B Clarke"
            ],
            "display": [
                {
                    "label": "label",
                    "text": "${label}",
                    "type": "text"
                },
                {
                    "label": "Affiliation",
                    "text": "${affiliation}",
                    "type": "text"
                }
            ],
            "relation": [
		"Publications",
		"MeSH",
		"Awards"
			],
            "search": [
                "label"
            ],
	    "color": "#80D8FF"
        },
        {
            "node": "Awards",
            "example": [
                "1U54OD036472-01",
                "1R03OD038391-01"
            ],
            "display": [
                {
                    "label": "label",
                    "text": "${label}",
                    "type": "text"
                },
                {
                    "label": "Contact",
                    "text": "${Contact}",
                    "type": "text"
                },
		{
		    "label": "Title",
		    "text": "${Title}",
		    "type": "text"
		},
		{
		    "label": "URL",
		    "text": "${project_detail_url}",
		    "href": "${project_detail_url}",
		    "type": "link"
		}
            ],
            "relation": [],
            "search": [
                "label",
		"Title"
            ],
	    "color": "#f59f5d"
        },
        {
            "node": "Publications",
            "example": [
		    "35188328",
		    "36456625"
            ],
            "display": [
                {
                    "label": "label",
                    "text": "${label}",
                    "type": "text"
                },
                {
                    "label": "URL",
                    "text": "${PMID}",
                    "href": "${url}",
                    "type": "link"
                },
                {
                    "label": "Title",
                    "text": "${Title}",
                    "type": "text"
                },
                {
                    "label": "Journal",
                    "text": "${Journal}",
                    "type": "text"
                },
                {
                    "label": "Volume",
                    "text": "${Volume}",
                    "type": "text"
                },
                {
                    "label": "Issue",
                    "text": "${Issue}",
                    "type": "text"
                },
                {
                    "label": "Pages",
                    "text": "${Pages}",
                    "type": "text"
                },
                {
                    "label": "Year",
                    "text": "${Year}",
                    "type": "text"
                }
            ],
            "relation": [
		"Publications",
		"MeSH",
		"Awards"
	    ],
            "search": [
		"label",
                "Title"
            ],
	    "color": "#97BDB8"
        },
        {
            "node": "MeSH",
            "example": [
                "Acetates",
                "Data Mining"
            ],
            "display": [
                {
                    "label": "label",
                    "text": "${label}",
                    "type": "text"
                }
            ],
            "relation": [
				"MeSH"
			],
            "search": [
                "label"
            ],
			"color": "#b1f774"
        }
    ],
    "edges": [
        {
            "match": [
                "Publications"
            ],
            "selected": true,
            "display": [
                {
                    "label": "source label",
                    "text": "${source_label}",
                    "type": "text"
                },
                {
                    "label": "relation",
                    "text": "${relation}",
                    "type": "text"
                },
                {
                    "label": "target label",
                    "text": "${target_label}",
                    "type": "text"
                }
            ]
        },
        {
            "match": [
                "MeSH"
            ],
            "selected": true,
            "display": [
                {
                    "label": "source label",
                    "text": "${source_label}",
                    "type": "text"
                },
                {
                    "label": "relation",
                    "text": "${relation}",
                    "type": "text"
                },
                {
                    "label": "target label",
                    "text": "${target_label}",
                    "type": "text"
                }
            ]
        },
        {
            "match": [
                "Awards"
            ],
            "selected": true,
            "display": [
                {
                    "label": "source label",
                    "text": "${source_label}",
                    "type": "text"
                },
                {
                    "label": "relation",
                    "text": "${relation}",
                    "type": "text"
                },
                {
                    "label": "target label",
                    "text": "${target_label}",
                    "type": "text"
                }
            ]
        }
