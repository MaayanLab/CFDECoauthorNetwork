{
    "nodes": [
        {
            "node": "Authors",
            "example": [
                "Avi Ma'ayan",
                "Daniel J B Clarke"
            ],
            "display": [
                {
                    "label": "label",
                    "text": "${label}",
                    "type": "text"
                },
                {
                    "label": "Affiliation",
                    "text": "${affiliation}",
                    "type": "text"
                },
		{
		    "label": "CFDE Center",
		    "text": "${CFDE_Center}",
		    "type": "text"
		}
            ],
            "relation": [
		"Publications",
		"MeSH",
		"Awards"
			],
            "search": [
                "label"
            ],
	    "color": "#80D8FF"
        },
        {
            "node": "Awards",
            "example": [
                "1U54OD036472-01",
                "1R03OD038391-01"
            ],
            "display": [
                {
                    "label": "label",
                    "text": "${label}",
                    "type": "text"
                },
                {
                    "label": "Contact",
                    "text": "${Contact}",
                    "type": "text"
                },
		{
		    "label": "Title",
		    "text": "${Title}",
		    "type": "text"
		},
		{
		    "label": "URL",
		    "text": "${project_detail_url}",
		    "href": "${project_detail_url}",
		    "type": "link"
		}
            ],
            "relation": [],
            "search": [
                "label",
		"Title"
            ],
	    "color": "#f59f5d"
        },
        {
            "node": "Publications",
            "example": [
		    "35188328",
		    "36456625"
            ],
            "display": [
                {
                    "label": "label",
                    "text": "${label}",
                    "type": "text"
                },
                {
                    "label": "URL",
                    "text": "${label}",
                    "href": "https://pubmed.ncbi.nlm.nih.gov/${label}/",
                    "type": "link"
                },
                {
                    "label": "Title",
                    "text": "${Title}",
                    "type": "text"
                },
		{
		    "label": "Authors",
		    "text": "${Authors}",
		    "type": "text"
		},
                {
                    "label": "Journal",
                    "text": "${Journal}",
                    "type": "text"
		}
            ],
            "relation": [
		"Publications",
		"MeSH",
		"Awards"
	    ],
            "search": [
		"label",
                "Title"
            ],
	    "color": "#97BDB8"
        },
        {
            "node": "MeSH",
            "example": [
                "Acetates",
                "Data Mining"
            ],
            "display": [
                {
                    "label": "label",
                    "text": "${label}",
                    "type": "text"
                }
            ],
            "relation": [
				"MeSH"
			],
            "search": [
                "label"
            ],
			"color": "#b1f774"
        }
    ],
    "edges": [
        {
            "match": [
                "Publications"
            ],
            "selected": true,
            "display": [
                {
                    "label": "source",
                    "text": "${source}",
                    "type": "text"
                },
                {
                    "label": "relation",
                    "text": "${relation}",
                    "type": "text"
                },
                {
                    "label": "target",
                    "text": "${target}",
                    "type": "text"
                }
            ]
        },
        {
            "match": [
                "MeSH"
            ],
            "selected": true,
            "display": [
                {
                    "label": "source label",
                    "text": "${source}",
                    "type": "text"
                },
                {
                    "label": "relation",
                    "text": "${relation}",
                    "type": "text"
                },
                {
                    "label": "target label",
                    "text": "${target}",
                    "type": "text"
                }
            ]
        },
        {
            "match": [
                "Awards"
            ],
            "selected": true,
            "display": [
                {
                    "label": "source label",
                    "text": "${source}",
                    "type": "text"
                },
                {
                    "label": "relation",
                    "text": "${relation}",
                    "type": "text"
                },
                {
                    "label": "target label",
                    "text": "${target}",
                    "type": "text"
                }
            ]
        },
	{
		"match": [
			"Coauthors"
		],
		"selected": false,
		"display": [
		    {
			"label": "source",
			"text": "${source}",
			"type":"text"
		    },
		    {
			"label": "relation",
			"text": "${relation}",
			"type":"text"
		    },
		    {
			"label": "target",
			"text": "${target}",
			"type":"text"
		    }
		],
		"hidden": true
	}
    ],
    "header": {
        "header": "CFDE Co-authorship Network",
        "title": "CFDE Co-authorship Network",
        "background": {
            "backgroundColor": "#000",
            "contrastText": "#FFF"
        },
        "icon": {
            "src": "https://s3.amazonaws.com/maayan-kg/cfde-kg/assets/CFDE.png",
            "favicon": "https://s3.amazonaws.com/maayan-kg/cfde-kg/assets/favicon.png",
            "faviconTitle": "CFDE Co-author Network",
            "alt": "CFDE logo",
            "key": "CFDE_logo",
            "width": 100,
            "height": 100
        },
        "tabs": [
            {
                "endpoint": "/",
                "label": "Co-authorship KG Explorer",
                "type": "page",
                "component": "CoauthorSearch",
                "props": {
					"description": "The Common Fund Data Ecosystem (CFDE) is an NIH initiative that enhances the accessibility and usability of diverse datasets from various Common Fund programs. By integrating these datasets, the CFDE ensures they are FAIR (Findable, Accessible, Interoperable, and Reusable), accelerating scientific discovery and enabling researchers to tackle complex biomedical questions. \n\n This application integrates information on CFDE grant authors, publications, MeSH terms, and awarded grants into a structured knowledge graph, allowing researchers to explore relationships between awards, research outputs, and biomedical topics more effectively.", 
                    "init_function": "initialize_kg",
                    "initial_query": {
                        "start": "Authors",
                        "start_term": "Avi Ma'ayan",
			"relation": [
				{
					"name":"Publications"
				},
				{
					"name":"MeSH"
				},
				{
					"name":"Awards"
				}
			],
			"search_type": "explore"
                    },
                    "subheader": {
                        "url_field": "filter",
                        "query_field": "relation"
                    },
		    "extras": [
			"Publications",
			"Awards",
			"MeSH"
		    ]
                }
            },
	    {
		"endpoint": "/downloadfiles",
		"label": "Download",
		"type": "page",
		"component": "DownloadFiles",
		"props" : {
			"src":"https://raw.githubusercontent.com/MaayanLab/CFDECoauthorNetwork/refs/heads/next14/public/downloads.json" 
		}
	    },
	    {
	    	"endpoint": "/networkstats",
		"label": "Network Statistics",
		"type": "page",
		"component": "NetworkStatistics",
		"props" : {
		}
	    }
	]
    },
    "footer": {
