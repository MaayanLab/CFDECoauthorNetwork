    "header": {
        "header": "CFDE Co-authorship Network",
        "title": "CFDE Co-authorship Network",
        "background": {
            "backgroundColor": "#000",
            "contrastText": "#FFF"
        },
        "icon": {
            "src": "https://s3.amazonaws.com/maayan-kg/cfde-kg/assets/CFDE.png",
            "favicon": "https://s3.amazonaws.com/maayan-kg/cfde-kg/assets/favicon.png",
            "faviconTitle": "CFDE Co-author Network",
            "alt": "CFDE logo",
            "key": "CFDE_logo",
            "width": 100,
            "height": 100
        },
        "tabs": [
            {
                "endpoint": "/",
                "label": "Co-authorship KG Explorer",
                "type": "page",
                "component": "CoauthorSearch",
                "props": {
					"description": "Explore the connections between the authors their publications and related MeSH terms.",
                    "init_function": "initialize_kg",
                    "initial_query": {
                        "start": "Authors",
                        "start_term": "Avi Ma'ayan",
			"relation": [
				{
					"name":"Publications"
				},
				{
					"name":"MeSH"
				},
				{
					"name":"Awards"
				}
			],
			"search_type": "explore"
                    },
                    "subheader": {
                        "url_field": "filter",
                        "query_field": "relation"
                    },
		    "extras": [
			"Publications",
			"Awards",
			"MeSH"
		    ]
                }
            }
	]
    },
    "footer": {
